---
import "../styles/global.css";
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
import { company } from "../data/company";
import { withBase } from "../utils/paths";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  theme?: "company" | "friday" | "wordex";
}

const { title, description, canonicalPath = Astro.url.pathname, theme = "company" } = Astro.props;
const pageTitle = title === company.name ? title : `${title}`;
const canonical = new URL(withBase(canonicalPath), Astro.site).toString();
const ogImage = new URL(withBase("/og/cover.png"), Astro.site).toString();

const themeColor =
  theme === "friday" ? "#fdf6ee" : theme === "wordex" ? "#f7f4ec" : "#0a0e0d";
---

<!doctype html>
<html lang="zh-CN" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Spectral:wght@400;500;600;700&family=Baloo+2:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@500;600;700&family=Syne:wght@700;800&family=Bebas+Neue&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <div class="magnetic-cursor" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>
    <Navbar theme={theme} />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (() => {
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const items = document.querySelectorAll(".reveal");
        if (reduce || !("IntersectionObserver" in window)) {
          items.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.08 }
        );
        items.forEach((el) => io.observe(el));
      })();
    </script>
    <script is:inline>
      (() => {
        const cursor = document.querySelector(".magnetic-cursor");
        if (!cursor) return;

        const finePointer = window.matchMedia("(pointer: fine)").matches;
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!finePointer || reduce) return;

        const magneticSelector = [
          "a[href]",
          "button",
          "[role='button']",
          "[data-magnetic]"
        ].join(",");

        let target = null;
        let mouseX = window.innerWidth / 2;
        let mouseY = window.innerHeight / 2;
        let cursorX = mouseX;
        let cursorY = mouseY;

        const lerp = (from, to, amount) => from + (to - from) * amount;

        const resizeTo = (width, height) => {
          cursor.style.setProperty("--cursor-w", `${Math.min(width + 18, 360)}px`);
          cursor.style.setProperty("--cursor-h", `${Math.min(height + 14, 132)}px`);
        };

        const resetSize = () => {
          cursor.style.removeProperty("--cursor-w");
          cursor.style.removeProperty("--cursor-h");
        };

        const isTransparent = (color) => {
          if (!color || color === "transparent") return true;
          const match = color.match(/rgba?\(([^)]+)\)/);
          if (!match) return false;
          const parts = match[1].split(",").map((part) => Number.parseFloat(part.trim()));
          return parts.length === 4 && parts[3] === 0;
        };

        const luminance = (color) => {
          const match = color.match(/rgba?\(([^)]+)\)/);
          if (!match) return 1;
          const [r, g, b] = match[1].split(",").map((part) => Number.parseFloat(part.trim()) / 255);
          const linear = [r, g, b].map((value) =>
            value <= 0.03928 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4
          );
          return 0.2126 * linear[0] + 0.7152 * linear[1] + 0.0722 * linear[2];
        };

        const backgroundAt = (x, y) => {
          const previousDisplay = cursor.style.display;
          cursor.style.display = "none";
          let node = document.elementFromPoint(x, y);
          cursor.style.display = previousDisplay;

          let bg = "";
          while (node && node !== document.documentElement) {
            bg = getComputedStyle(node).backgroundColor;
            if (!isTransparent(bg)) break;
            node = node.parentElement;
          }

          if (isTransparent(bg)) {
            bg = getComputedStyle(document.body).backgroundColor;
          }

          return bg;
        };

        const syncTone = (hit, nextTarget) => {
          if (nextTarget) {
            const rect = nextTarget.getBoundingClientRect();
            const cursorWidth = Math.min(rect.width + 18, 360);
            const cursorHeight = Math.min(rect.height + 14, 132);
            const centerX = rect.left + rect.width / 2;
            const centerY = rect.top + rect.height / 2;
            const inset = 2;
            const points = [
              [centerX - cursorWidth / 2 + inset, centerY - cursorHeight / 2 + inset],
              [centerX + cursorWidth / 2 - inset, centerY - cursorHeight / 2 + inset],
              [centerX + cursorWidth / 2 - inset, centerY + cursorHeight / 2 - inset],
              [centerX - cursorWidth / 2 + inset, centerY + cursorHeight / 2 - inset]
            ];

            const darkest = points.reduce((min, [x, y]) => {
              const clampedX = Math.max(0, Math.min(window.innerWidth - 1, x));
              const clampedY = Math.max(0, Math.min(window.innerHeight - 1, y));
              return Math.min(min, luminance(backgroundAt(clampedX, clampedY)));
            }, 1);

            cursor.classList.toggle("is-on-dark", darkest < 0.34);
            return;
          }

          let node = hit;
          let bg = "";

          while (node && node !== document.documentElement) {
            bg = getComputedStyle(node).backgroundColor;
            if (!isTransparent(bg)) break;
            node = node.parentElement;
          }

          if (isTransparent(bg)) {
            bg = getComputedStyle(document.body).backgroundColor;
          }

          cursor.classList.toggle("is-on-dark", luminance(bg) < 0.28);
        };

        const setTarget = (nextTarget) => {
          if (nextTarget?.dataset.noMagnetic === "true") nextTarget = null;
          if (nextTarget === target) return;
          target = nextTarget;

          if (target) {
            const rect = target.getBoundingClientRect();
            resizeTo(rect.width, rect.height);
            cursor.classList.add("is-locked");
          } else {
            resetSize();
            cursor.classList.remove("is-locked");
          }
        };

        document.documentElement.classList.add("has-magnetic-cursor");

        document.addEventListener("mousemove", (event) => {
          mouseX = event.clientX;
          mouseY = event.clientY;
          const hit = document.elementFromPoint(mouseX, mouseY);
          const nextTarget = hit?.closest(magneticSelector);
          syncTone(hit, nextTarget);
          setTarget(nextTarget);
          cursor.classList.add("is-visible");
        }, { passive: true });

        document.addEventListener("mouseleave", () => {
          setTarget(null);
          cursor.classList.remove("is-visible", "is-locked");
        });

        const tick = () => {
          let nextX = mouseX;
          let nextY = mouseY;

          if (target) {
            const rect = target.getBoundingClientRect();
            const centerX = rect.left + rect.width / 2;
            const centerY = rect.top + rect.height / 2;
            nextX = centerX + (mouseX - centerX) * 0.18;
            nextY = centerY + (mouseY - centerY) * 0.18;
          }

          cursorX = lerp(cursorX, nextX, 0.22);
          cursorY = lerp(cursorY, nextY, 0.22);
          cursor.style.transform = `translate3d(${cursorX}px, ${cursorY}px, 0) translate(-50%, -50%)`;
          requestAnimationFrame(tick);
        };

        tick();
      })();
    </script>
  </body>
</html>
