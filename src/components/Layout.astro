---
import "../styles/global.css";
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
import { company } from "../data/company";
import { withBase } from "../utils/paths";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  theme?: "company" | "friday" | "wordex";
}

const { title, description, canonicalPath = Astro.url.pathname, theme = "company" } = Astro.props;
const pageTitle = title === company.name ? title : `${title}`;
const canonical = new URL(withBase(canonicalPath), Astro.site).toString();
const ogImage = new URL(withBase("/og/cover.png"), Astro.site).toString();

const themeColor =
  theme === "friday" ? "#fdf6ee" : theme === "wordex" ? "#f7f4ec" : "#0a0e0d";

const siteUrl = new URL(withBase("/"), Astro.site).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      name: company.legalNameZh,
      alternateName: [company.name, company.legalNameEn],
      url: siteUrl,
      email: company.businessEmail,
      description: company.description,
      slogan: company.tagline,
      foundingLocation: {
        "@type": "Place",
        name: "北京"
      },
      areaServed: "CN",
      knowsAbout: [
        "人工智能技术研发",
        "大模型应用",
        "AI 产品落地",
        "私有化部署",
        "定制化开发",
        "正式文档处理"
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: company.name,
      publisher: { "@id": `${siteUrl}#organization` },
      inLanguage: "zh-CN"
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: pageTitle,
      description,
      isPartOf: { "@id": `${siteUrl}#website` },
      about: { "@id": `${siteUrl}#organization` },
      inLanguage: "zh-CN"
    }
  ]
};
---

<!doctype html>
<html lang="zh-CN" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href={withBase("/favicon.ico")} sizes="any" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Spectral:wght@400;500;600;700&family=Baloo+2:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@500;600;700&family=Syne:wght@700;800&family=Bebas+Neue&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <div class="magnetic-cursor" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>
    <div class="text-lens" aria-hidden="true">
      <div class="text-lens__surface">
        <div class="text-lens__stage"></div>
      </div>
    </div>
    <Navbar theme={theme} />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (() => {
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const items = document.querySelectorAll(".reveal");
        if (reduce || !("IntersectionObserver" in window)) {
          items.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.08 }
        );
        items.forEach((el) => io.observe(el));
      })();
    </script>
    <script is:inline>
      (() => {
        const cursor = document.querySelector(".magnetic-cursor");
        const lens = document.querySelector(".text-lens");
        const lensSurface = lens?.querySelector(".text-lens__surface");
        const lensStage = lens?.querySelector(".text-lens__stage");
        if (!cursor || !lens || !lensSurface || !lensStage) return;

        const finePointer = window.matchMedia("(pointer: fine)").matches;
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!finePointer || reduce) return;

        const magneticSelector = ["a[href]", "button", "[role='button']", "[data-magnetic]"].join(",");
        const lensSelector = "[data-magnify]";

        let target = null;
        let lensTarget = null;
        let lensRegion = null;
        let mouseX = window.innerWidth / 2;
        let mouseY = window.innerHeight / 2;
        let cursorX = mouseX;
        let cursorY = mouseY;
        let lensX = mouseX;
        let lensY = mouseY;
        let lensClearTimer = 0;

        const lerp = (from, to, amount) => from + (to - from) * amount;

        const resizeTo = (width, height) => {
          cursor.style.setProperty("--cursor-w", `${Math.min(width + 18, 360)}px`);
          cursor.style.setProperty("--cursor-h", `${Math.min(height + 14, 132)}px`);
        };

        const resetSize = () => {
          cursor.style.removeProperty("--cursor-w");
          cursor.style.removeProperty("--cursor-h");
        };

        const isTransparent = (color) => {
          if (!color || color === "transparent") return true;
          const match = color.match(/rgba?\(([^)]+)\)/);
          if (!match) return false;
          const parts = match[1].split(",").map((part) => Number.parseFloat(part.trim()));
          return parts.length === 4 && parts[3] === 0;
        };

        const luminance = (color) => {
          const match = color.match(/rgba?\(([^)]+)\)/);
          if (!match) return 1;
          const [r, g, b] = match[1].split(",").map((part) => Number.parseFloat(part.trim()) / 255);
          const linear = [r, g, b].map((value) =>
            value <= 0.03928 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4
          );
          return 0.2126 * linear[0] + 0.7152 * linear[1] + 0.0722 * linear[2];
        };

        const backgroundAt = (x, y) => {
          const previousCursorDisplay = cursor.style.display;
          const previousLensDisplay = lens.style.display;
          cursor.style.display = "none";
          lens.style.display = "none";
          let node = document.elementFromPoint(x, y);
          cursor.style.display = previousCursorDisplay;
          lens.style.display = previousLensDisplay;

          let bg = "";
          while (node && node !== document.documentElement) {
            bg = getComputedStyle(node).backgroundColor;
            if (!isTransparent(bg)) break;
            node = node.parentElement;
          }

          if (isTransparent(bg)) {
            bg = getComputedStyle(document.body).backgroundColor;
          }

          return bg;
        };

        const stripLensClone = (node) => {
          node.removeAttribute?.("id");
          node.removeAttribute?.("data-magnify");
          node.querySelectorAll?.("[id], [data-magnify]").forEach((child) => {
            child.removeAttribute("id");
            child.removeAttribute("data-magnify");
          });
        };

        const setLensTarget = (nextTarget) => {
          if (nextTarget === lensTarget) return;
          window.clearTimeout(lensClearTimer);
          lensTarget = nextTarget;
          lensRegion = lensTarget?.closest("[data-magnify-region]") || lensTarget?.parentElement || lensTarget;

          if (!lensTarget) {
            lensRegion = null;
            lens.classList.remove("is-active");
            cursor.classList.remove("is-lensing");
            document.documentElement.classList.remove("is-lens-hit");
            lensClearTimer = window.setTimeout(() => {
              if (!lensTarget) lensStage.replaceChildren();
            }, 220);
            return;
          }

          lensStage.replaceChildren();
          const clone = lensRegion.cloneNode(true);
          stripLensClone(clone);
          clone.classList.add("text-lens__clone");
          lensStage.append(clone);
          lensX = mouseX;
          lensY = mouseY;
          lens.classList.remove("is-active");
          lensSurface.getBoundingClientRect();
          lens.classList.add("is-active");
          cursor.classList.add("is-lensing");
          document.documentElement.classList.add("is-lens-hit");
        };

        const getLensHitRects = (item) => {
          const range = document.createRange();
          range.selectNodeContents(item);
          const rects = [...range.getClientRects()].filter((rect) => rect.width > 1 && rect.height > 1);
          range.detach();
          return rects.length ? rects : [item.getBoundingClientRect()];
        };

        const isWithinLensHitArea = (item) => {
          const padding = Number.parseFloat(item.dataset.magnifyPadding || "24");
          return getLensHitRects(item).some((rect) => {
            const withinX = mouseX >= rect.left - padding && mouseX <= rect.right + padding;
            const withinY = mouseY >= rect.top - padding && mouseY <= rect.bottom + padding;
            return withinX && withinY;
          });
        };

        const findLensTarget = (hit, blockedTarget) => {
          if (blockedTarget) return null;

          const directTarget = hit?.closest(lensSelector);
          if (directTarget && isWithinLensHitArea(directTarget)) return directTarget;

          for (const item of document.querySelectorAll(lensSelector)) {
            if (isWithinLensHitArea(item)) return item;
          }

          return null;
        };

        const updateLens = () => {
          if (!lensTarget || !lensRegion) return;

          const regionRect = lensRegion.getBoundingClientRect();
          const size = Number.parseFloat(lensTarget.dataset.magnifySize || "118");
          const scale = Number.parseFloat(lensTarget.dataset.magnifyScale || "1.65");
          const bg = backgroundAt(mouseX, mouseY);
          const clone = lensStage.firstElementChild;

          lensX = lerp(lensX, mouseX, 0.11);
          lensY = lerp(lensY, mouseY, 0.11);
          lens.style.setProperty("--lens-size", `${size}px`);
          lens.style.setProperty("--lens-bg", bg);
          lens.style.transform = `translate3d(${lensX}px, ${lensY}px, 0) translate(-50%, -50%)`;

          if (clone) {
            clone.style.width = `${regionRect.width}px`;
            clone.style.height = `${regionRect.height}px`;
            clone.style.left = `${size / 2 - (lensX - regionRect.left) * scale}px`;
            clone.style.top = `${size / 2 - (lensY - regionRect.top) * scale}px`;
            clone.style.transform = `scale(${scale})`;
          }
        };

        const syncTone = (hit, nextTarget) => {
          if (nextTarget) {
            const rect = nextTarget.getBoundingClientRect();
            const cursorWidth = Math.min(rect.width + 18, 360);
            const cursorHeight = Math.min(rect.height + 14, 132);
            const centerX = rect.left + rect.width / 2;
            const centerY = rect.top + rect.height / 2;
            const inset = 2;
            const points = [
              [centerX - cursorWidth / 2 + inset, centerY - cursorHeight / 2 + inset],
              [centerX + cursorWidth / 2 - inset, centerY - cursorHeight / 2 + inset],
              [centerX + cursorWidth / 2 - inset, centerY + cursorHeight / 2 - inset],
              [centerX - cursorWidth / 2 + inset, centerY + cursorHeight / 2 - inset]
            ];

            const darkest = points.reduce((min, [x, y]) => {
              const clampedX = Math.max(0, Math.min(window.innerWidth - 1, x));
              const clampedY = Math.max(0, Math.min(window.innerHeight - 1, y));
              return Math.min(min, luminance(backgroundAt(clampedX, clampedY)));
            }, 1);

            cursor.classList.toggle("is-on-dark", darkest < 0.34);
            return;
          }

          let node = hit;
          let bg = "";

          while (node && node !== document.documentElement) {
            bg = getComputedStyle(node).backgroundColor;
            if (!isTransparent(bg)) break;
            node = node.parentElement;
          }

          if (isTransparent(bg)) {
            bg = getComputedStyle(document.body).backgroundColor;
          }

          cursor.classList.toggle("is-on-dark", luminance(bg) < 0.28);
        };

        const setTarget = (nextTarget) => {
          if (nextTarget?.dataset.noMagnetic === "true") nextTarget = null;
          if (nextTarget === target) return;
          target = nextTarget;

          if (target) {
            const rect = target.getBoundingClientRect();
            resizeTo(rect.width, rect.height);
            cursor.classList.add("is-locked");
          } else {
            resetSize();
            cursor.classList.remove("is-locked");
          }
        };

        document.documentElement.classList.add("has-magnetic-cursor");

        const move = (event) => {
          if (typeof event.clientX !== "number" || typeof event.clientY !== "number") return;
          mouseX = event.clientX;
          mouseY = event.clientY;
          const hit = document.elementFromPoint(mouseX, mouseY);
          const nextTarget = hit?.closest(magneticSelector);
          const nextLensTarget = findLensTarget(hit, nextTarget);
          syncTone(hit, nextTarget);
          setTarget(nextTarget);
          setLensTarget(nextLensTarget);
          updateLens();
          cursor.classList.add("is-visible");
        };

        document.addEventListener("mousemove", move, { passive: true });

        document.addEventListener("mouseleave", () => {
          setTarget(null);
          setLensTarget(null);
          cursor.classList.remove("is-visible", "is-locked");
        });

        const tick = () => {
          let nextX = mouseX;
          let nextY = mouseY;

          if (target) {
            const rect = target.getBoundingClientRect();
            const centerX = rect.left + rect.width / 2;
            const centerY = rect.top + rect.height / 2;
            nextX = centerX + (mouseX - centerX) * 0.18;
            nextY = centerY + (mouseY - centerY) * 0.18;
          }

          const cursorEase = target ? 0.18 : 0.32;
          cursorX = lerp(cursorX, nextX, cursorEase);
          cursorY = lerp(cursorY, nextY, cursorEase);
          cursor.style.transform = `translate3d(${cursorX}px, ${cursorY}px, 0) translate(-50%, -50%)`;
          updateLens();
          requestAnimationFrame(tick);
        };

        tick();
      })();
    </script>
  </body>
</html>
